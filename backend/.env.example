# ========================================================
# CHEM BROS E-COMMERCE BACKEND ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your values.
# NEVER commit .env with real production secrets to Git.
# ========================================================

# Server Runtime
NODE_ENV=development
PORT=5000

# PostgreSQL Database Connection URL (e.g. from Neon, Supabase, Railway, or local)
# Format: postgresql://[user]:[password]@[host]:[port]/[dbname]?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/chembros_db?schema=public"

# Session Security (Generate a secure 32+ character random string)
SESSION_SECRET="chembros_super_secure_session_secret_change_in_production_32chars"

# Frontend Origin for CORS Whitelist
CORS_ORIGIN="http://localhost:3000"

# Cashfree Payment Gateway Credentials
CASHFREE_APP_ID="TEST_YOUR_CASHFREE_APP_ID"
CASHFREE_SECRET_KEY="TEST_YOUR_CASHFREE_SECRET_KEY"
CASHFREE_ENVIRONMENT="sandbox"

# Sanity CMS (For editorial stories, journal, FAQs)
SANITY_PROJECT_ID="your_sanity_project_id"
SANITY_DATASET="production"
SANITY_API_VERSION="2024-03-01"
